# Supabase project used by the Skydex app (shaft_sessions table).
SUPABASE_URL=https://svzzzcxzukdvzdnxfapc.supabase.co
# Public anon key — enough to browse sessions.
SUPABASE_ANON_KEY=
# service_role key (Supabase dashboard → Project Settings → API). Required to read/save labels.
SUPABASE_SERVICE_ROLE_KEY=
# Firebase Storage bucket holding the sensor CSVs.
FIREBASE_BUCKET=nahori-shaft
# Firebase Admin service-account JSON for project "nahori", on a single line in single quotes.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account", ...}'
# Random string used to sign login cookies:  openssl rand -hex 32
AUTH_SECRET=
